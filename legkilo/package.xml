<?xml version="1.0"?>
<package format="3">
  <name>legkilo</name>
  <version>0.0.0</version>

  <description>

    This is a modified and optimized version of the paper 
    "Leg-KILO: Robust Kinematic-Inertial-Lidar Odometry for Dynamic Legged Robots"
    https://doi.org/10.1109/LRA.2024.3440730

  </description>

  <maintainer email="ouguangjun98@gmail.com">Guangjun Ou</maintainer>

  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>visualization_msgs</depend>
  <depend>go2_driver</depend>
  <depend>small_gicp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
